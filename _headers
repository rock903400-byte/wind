# ==============================================================================
# Cloudflare Pages Custom Headers Configuration
# ==============================================================================

# 1. 全站通用安全標頭 (Security Headers)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://script.google.com https://script.googleusercontent.com https://fonts.googleapis.com https://fonts.gstatic.com; frame-src 'self' https://docs.google.com https://script.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://docs.google.com https://script.google.com;

# 2a. assets 共用標頭（刻意不含 Cache-Control，避免與下方規則合併衝突）
/assets/*
  Access-Control-Allow-Origin: *

# 2b. 程式碼類：每次都向伺服器確認，push 後立即生效
/assets/*.js
  Cache-Control: public, max-age=0, must-revalidate

/assets/*.css
  Cache-Control: public, max-age=0, must-revalidate
  # 明示 charset：CSS 沒有 HTTP charset 時瀏覽器會退回猜測，實測會把
  # style.css 的 '↗' 解成 'â†—'（Latin-1）。各檔第一行的 @charset 是第二道保險。
  Content-Type: text/css; charset=utf-8

# 2c. 圖片／字型：內容不變，維持一年 immutable
/assets/*.webp
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

/assets/*.jpg
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

/assets/*.png
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

/assets/*.svg
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

# 3. HTML 網頁及時重新驗證快取 (確保 push 更新立即生效)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# 4. 搜尋引擎相關檔案 (1 天快取)
/robots.txt
  Cache-Control: public, max-age=86400, s-maxage=86400
  Access-Control-Allow-Origin: *

/sitemap.xml
  Cache-Control: public, max-age=86400, s-maxage=86400
  Access-Control-Allow-Origin: *

/llms.txt
  Cache-Control: public, max-age=86400, s-maxage=86400
  Access-Control-Allow-Origin: *
  Content-Type: text/plain; charset=utf-8
